{
  "name": "@les-cabochons/ajp-workday-agent",
  "version": "0.6.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@10.7.0",
  "ajour": {
    "description": "Commit your Ajour week to the Workday web timesheet through a coding agent, Claude Code, Codex or OpenCode, in a Chrome window. Unofficial. It drives Workday's page, so it breaks when the page changes. It never signs in for you.",
    "features": [
      "timesheet-commit",
      "timesheet-submit",
      "project-properties"
    ],
    "tags": [
      "workday",
      "timesheet",
      "agent"
    ],
    "author": {
      "name": "Alex Trépanier",
      "url": "https://github.com/alextrepa"
    },
    "license": {
      "name": "MIT License",
      "spdxId": "MIT"
    },
    "website": "https://docs.ajour.day/plugins/workday-agent",
    "status": "available",
    "files": [
      "plugin.json",
      "package.json",
      "LICENSE",
      "prompts"
    ]
  },
  "scripts": {
    "test": "node --test",
    "verify": "corepack pnpm test"
  },
  "devDependencies": {
    "@ajour/plugin-sdk": "file:../../vendor/ajour-plugin-sdk-0.1.0.tgz",
    "typescript": "^5.8.2"
  }
}
