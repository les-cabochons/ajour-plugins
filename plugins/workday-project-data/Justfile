# Workday project data plugin command surface

set quiet
set windows-shell := ["powershell.exe", "-NoLogo", "-Command"]

PNPM := "corepack pnpm"

[private]
default: help

[doc("Displays available commands")]
help:
    just --list --unsorted

[doc("Runs plugin tests")]
test:
    {{PNPM}} test

[doc("Checks JavaScript syntax")]
typecheck:
    {{PNPM}} typecheck

[doc("Runs the complete local verification")]
verify:
    {{PNPM}} verify
