{
  "id": "github",
  "version": "0.1.0",
  "apiVersion": 2,
  "displayName": "GitHub",
  "description": "Brings your GitHub pull requests into Ajour: the ones you wrote and the ones you were asked to review.",
  "iconSvg": "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 16 16\"><path fill=\"currentColor\" d=\"M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z\"/></svg>",
  "entrypoint": "dist/plugin.js",
  "capabilities": {
    "codeHost": {}
  },
  "connectionFields": [
    {
      "id": "label",
      "label": "Connection label",
      "type": "text",
      "required": true,
      "placeholder": "Work"
    },
    {
      "id": "tenantLabel",
      "label": "Account",
      "type": "text",
      "required": true,
      "placeholder": "Acme on GitHub"
    },
    {
      "id": "hostUrl",
      "label": "GitHub URL",
      "type": "url",
      "required": true,
      "defaultValue": "https://github.com",
      "helpText": "Change it for GitHub Enterprise Server, for example https://github.acme.com."
    },
    {
      "id": "token",
      "label": "Personal access token",
      "type": "password",
      "required": true,
      "secret": true,
      "placeholder": "github_pat_…",
      "helpText": "Needs read and write access to pull requests and read access to the repositories, and read:org for team review requests."
    },
    {
      "id": "include",
      "label": "Only these organizations or repositories",
      "type": "text",
      "placeholder": "Optional: acme, octocat/hello-world",
      "helpText": "Comma-separated. An entry with a slash is a repository, otherwise an organization or user."
    },
    {
      "id": "exclude",
      "label": "Never these organizations or repositories",
      "type": "text",
      "placeholder": "Optional: acme/legacy"
    },
    {
      "id": "hideDrafts",
      "label": "Hide drafts",
      "type": "checkbox",
      "defaultValue": false
    },
    {
      "id": "includeTeamRequests",
      "label": "Include team review requests",
      "type": "checkbox",
      "defaultValue": true,
      "helpText": "Show pull requests where one of your teams was asked to review."
    },
    {
      "id": "autoSync",
      "label": "Sync automatically",
      "type": "checkbox",
      "defaultValue": true,
      "helpText": "Sync pull requests while the app is open."
    },
    {
      "id": "autoSyncIntervalMinutes",
      "label": "Sync interval (minutes)",
      "type": "number",
      "defaultValue": 5,
      "min": 1,
      "max": 1440,
      "step": 1
    }
  ]
}
