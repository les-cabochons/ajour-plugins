{
  "name": "@les-cabochons/ajc-github",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@10.7.0",
  "ajour": {
    "description": "Bring your GitHub issues into Ajour's backlog, and the pull requests you wrote or were asked to review.",
    "features": [
      "work-item-sync",
      "pull-requests"
    ],
    "tags": [
      "github",
      "code-review",
      "pull-requests"
    ],
    "author": {
      "name": "Alex Trépanier",
      "url": "https://github.com/alextrepa"
    },
    "license": {
      "name": "MIT License",
      "spdxId": "MIT"
    },
    "website": "https://github.com/les-cabochons/ajour-plugins/tree/main/plugins/github#readme",
    "status": "available",
    "files": [
      "plugin.json",
      "package.json",
      "LICENSE",
      "src"
    ]
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json",
    "verify": "corepack pnpm test && corepack pnpm typecheck"
  },
  "devDependencies": {
    "@ajour/plugin-sdk": "file:../../vendor/ajour-plugin-sdk-0.1.0.tgz",
    "@types/node": "^22.13.10",
    "typescript": "^5.8.2",
    "vitest": "^4.1.5"
  }
}
