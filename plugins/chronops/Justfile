# ChronOps plugin command surface

set quiet
set windows-shell := ["powershell.exe", "-NoLogo", "-Command"]

PNPM := "corepack pnpm"

[private]
default: help

[doc("Displays available commands")]
help:
    just --list --unsorted

[doc("Installs dependencies from the lockfile")]
install:
    corepack enable
    {{PNPM}} install

[doc("Runs the plugin tests, then the contract tests")]
test:
    {{PNPM}} test

[doc("Runs only the contract tests, the schema and the fake MineHunter")]
test-contract:
    {{PNPM}} test:contract

[doc("Type-checks the TypeScript source Ajour runs")]
typecheck:
    {{PNPM}} typecheck

[doc("Runs the complete local CI verification")]
verify:
    {{PNPM}} verify

[doc("Serves the fixture as MineHunter would, for example `just fake --scope read-write`")]
fake *args:
    node contract/fake-minehunter.mjs {{args}}
