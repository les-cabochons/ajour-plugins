{
  "id": "agent-handoff",
  "version": "0.9.0",
  "apiVersion": 4,
  "displayName": "Agent handoff",
  "description": "Hand off backlog items to T3 Code, Claude Code, Copilot CLI, OpenCode or Codex and follow their work.",
  "entrypoint": "src/plugin.ts",
  "iconSvg": "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\"><path d=\"M3 5h18v12H11l-5 4v-4H3z\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"/></svg>",
  "capabilities": {
    "handoff": {
      "promptTemplate": "[{{item.key}}] {{item.title}}\n\nWork on this {{item.type}} in the {{repo.name}} repository, from the folder you start in. Work on the branch you are on, and open a pull request when you are done.\n\nLink: {{item.url}}\nParent, if any: {{item.parent.key}} {{item.parent.title}}\n\n{{item.description}}",
      "tools": [
        {
          "id": "t3",
          "label": "T3 Code",
          "followsState": true,
          "listsThreads": true,
          "hooks": false,
          "iconSvg": "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\"><path d=\"M3 5h18v12H11l-5 4v-4H3z\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"/></svg>",
          "settings": [
            {
              "id": "worktree",
              "label": "Create a worktree",
              "type": "checkbox",
              "defaultValue": true,
              "helpText": "Run the thread in a new git worktree on the handoff branch, instead of the project folder."
            },
            {
              "id": "base",
              "label": "Worktree base",
              "type": "text",
              "defaultValue": "main",
              "helpText": "The branch, tag or commit the worktree starts from."
            },
            {
              "id": "provider",
              "label": "Provider",
              "type": "text",
              "placeholder": "claudeAgent",
              "helpText": "A T3 Code provider instance ID. A provider needs a model. Leave both empty for the project defaults."
            },
            {
              "id": "model",
              "label": "Model",
              "type": "text",
              "placeholder": "claude-opus-5-5",
              "helpText": "A model slug, which can contain slashes. Leave empty for the project's default model."
            }
          ]
        },
        {
          "id": "claude",
          "label": "Claude Code",
          "followsState": true,
          "listsThreads": true,
          "hooks": true,
          "iconSvg": "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\"><path d=\"M4 17l6-5-6-5M12 19h8\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg>",
          "settings": [
            {
              "id": "startMode",
              "label": "Start",
              "type": "select",
              "defaultValue": "background",
              "options": [
                {
                  "value": "background",
                  "label": "In the background"
                },
                {
                  "value": "terminal",
                  "label": "In the background, and open it in a terminal"
                }
              ],
              "helpText": "Claude Code always gets the prompt as a background session. Open shows it in your terminal later, or right away with the second choice."
            },
            {
              "id": "model",
              "label": "Model",
              "type": "text",
              "placeholder": "opus",
              "helpText": "A model alias such as opus or sonnet, or a full model name. Leave empty for your Claude Code default."
            }
          ]
        },
        {
          "id": "copilot",
          "label": "Copilot CLI",
          "followsState": false,
          "listsThreads": false,
          "hooks": false,
          "iconSvg": "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\"><path d=\"M4 17l6-5-6-5M12 19h8\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg>",
          "settings": [
            {
              "id": "tools",
              "label": "Tools",
              "type": "select",
              "defaultValue": "ask",
              "options": [
                {
                  "value": "ask",
                  "label": "Only the ones you already allowed"
                },
                {
                  "value": "allow",
                  "label": "Allow all tools (--allow-all-tools)"
                }
              ],
              "helpText": "Copilot CLI works on the prompt without a terminal, so it can't ask before it edits a file or runs a command: it skips each one you haven't allowed. Open the session to allow them and continue, or let it use every tool."
            },
            {
              "id": "model",
              "label": "Model",
              "type": "text",
              "placeholder": "auto",
              "helpText": "A model name, or auto to let Copilot choose. Leave empty for your Copilot CLI default."
            }
          ]
        },
        {
          "id": "opencode",
          "label": "OpenCode",
          "iconSvg": "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\"><path d=\"M4 17l6-5-6-5M12 19h8\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg>",
          "connection": "required",
          "followsState": true,
          "listsThreads": true,
          "hooks": false,
          "settings": [
            {
              "id": "model",
              "label": "Model",
              "type": "text",
              "placeholder": "anthropic/claude-sonnet-4-5",
              "helpText": "A provider and model as provider/model. Leave empty for your OpenCode default."
            },
            {
              "id": "agent",
              "label": "Agent",
              "type": "text",
              "placeholder": "build",
              "helpText": "An OpenCode agent, such as build or plan. Leave empty for your OpenCode default."
            }
          ]
        },
        {
          "id": "codex",
          "label": "Codex",
          "followsState": true,
          "listsThreads": true,
          "hooks": false,
          "iconSvg": "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\"><path d=\"M4 17l6-5-6-5M12 19h8\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg>",
          "settings": [
            {
              "id": "open",
              "label": "Open",
              "type": "select",
              "defaultValue": "app",
              "options": [
                {
                  "value": "app",
                  "label": "In the Codex app"
                },
                {
                  "value": "terminal",
                  "label": "In a terminal (codex resume)"
                }
              ],
              "helpText": "Where Open shows the thread. The Codex app opens it from its codex:// link; the terminal runs codex resume in the repository folder. Ajour runs at most two Codex handoffs at once."
            },
            {
              "id": "model",
              "label": "Model",
              "type": "text",
              "placeholder": "gpt-5.5",
              "helpText": "A model name for the thread. Leave empty for your Codex default."
            }
          ]
        }
      ]
    }
  },
  "connectionFields": [
    {
      "id": "label",
      "label": "Connection label",
      "type": "text",
      "required": true,
      "defaultValue": "OpenCode",
      "placeholder": "Name this connection"
    },
    {
      "id": "tenantLabel",
      "label": "Computer",
      "type": "text",
      "required": true,
      "defaultValue": "This computer",
      "placeholder": "Where the server runs"
    },
    {
      "id": "serverUrl",
      "label": "Server address",
      "type": "url",
      "required": true,
      "defaultValue": "http://127.0.0.1:4096",
      "helpText": "Where opencode serve listens. Start it in the repository folder with opencode serve --hostname 127.0.0.1 --port 4096, and mark this connection as on-premises."
    }
  ],
  "network": {
    "baseAddress": {
      "field": "serverUrl",
      "allowOnPremises": true
    },
    "endpoints": [
      { "method": "GET", "path": "/global/health" },
      { "method": "GET", "path": "/path" },
      { "method": "GET", "path": "/session" },
      { "method": "POST", "path": "/session" },
      { "method": "GET", "path": "/session/status" },
      { "method": "GET", "path": "/session/*" },
      { "method": "DELETE", "path": "/session/*" },
      { "method": "GET", "path": "/session/*/message" },
      { "method": "POST", "path": "/session/*/prompt_async" },
      { "method": "GET", "path": "/permission" },
      { "method": "GET", "path": "/question" }
    ],
    "requestHeaders": ["Content-Type"]
  },
  "processes": {
    "executables": {
      "t3": {
        "names": ["t3"]
      },
      "claude": {
        "names": ["claude"]
      },
      "copilot": {
        "names": ["copilot"]
      },
      "opencode": {
        "names": ["opencode"]
      },
      "codex": {
        "names": ["codex"]
      }
    },
    "commands": [
      {
        "id": "thread-start",
        "executable": "t3",
        "args": [
          "thread",
          "start",
          "{folder:folder}",
          "-",
          "--title",
          "{title:text}",
          "--json",
          {
            "if": "branch",
            "args": ["--worktree", "{base:ref}", "--branch", "{branch:ref}"]
          },
          {
            "if": "provider",
            "args": ["--provider", "{provider:text}"]
          },
          {
            "if": "model",
            "args": ["--model", "{model:text}"]
          }
        ],
        "stdin": "text",
        "mode": "capture",
        "timeoutSeconds": 20
      },
      {
        "id": "thread-list",
        "executable": "t3",
        "args": ["thread", "list", "--project", "{folder:folder}", "--json"],
        "mode": "capture",
        "timeoutSeconds": 10
      },
      {
        "id": "thread-show",
        "executable": "t3",
        "args": ["thread", "show", "{thread:id}", "--json", "--messages", "0"],
        "cwd": "{folder:folder}",
        "mode": "capture",
        "timeoutSeconds": 10
      },
      {
        "id": "version",
        "executable": "t3",
        "args": ["--version"],
        "mode": "capture",
        "timeoutSeconds": 10
      },
      {
        "id": "claude-start",
        "executable": "claude",
        "args": [
          "--bg",
          "--name",
          "{title:text}",
          {
            "if": "model",
            "args": ["--model", "{model:text}"]
          },
          "--add-dir",
          "{folder:folder}"
        ],
        "stdin": "text",
        "mode": "capture",
        "timeoutSeconds": 20
      },
      {
        "id": "claude-start-hook",
        "executable": "claude",
        "args": [
          "--bg",
          "--name",
          "{title:text}",
          {
            "if": "model",
            "args": ["--model", "{model:text}"]
          },
          "--settings",
          {
            "kind": "hook-url",
            "name": "hook",
            "template": "{\"hooks\":{\"Notification\":[{\"hooks\":[{\"type\":\"http\",\"url\":\"{url}\",\"timeout\":5}]}],\"SessionEnd\":[{\"hooks\":[{\"type\":\"http\",\"url\":\"{url}\"}]}]}}"
          },
          "--add-dir",
          "{folder:folder}"
        ],
        "stdin": "text",
        "mode": "capture",
        "timeoutSeconds": 20
      },
      {
        "id": "claude-agents",
        "executable": "claude",
        "args": ["agents", "--json", "--all"],
        "mode": "capture",
        "timeoutSeconds": 10
      },
      {
        "id": "claude-agents-folder",
        "executable": "claude",
        "args": ["agents", "--json", "--all", "--cwd", "{folder:folder}"],
        "mode": "capture",
        "timeoutSeconds": 10
      },
      {
        "id": "claude-attach",
        "executable": "claude",
        "args": ["attach", "{job:id}", "{folder:folder}"],
        "mode": "terminal"
      },
      {
        "id": "claude-version",
        "executable": "claude",
        "args": ["--version"],
        "mode": "capture",
        "timeoutSeconds": 10
      },
      {
        "id": "copilot-start",
        "executable": "copilot",
        "args": [
          "-C",
          "{folder:folder}",
          "--session-id",
          "{session:id}",
          "-n",
          "{title:text}",
          {
            "if": "model",
            "args": ["--model", "{model:text}"]
          }
        ],
        "stdin": "text",
        "mode": "detached"
      },
      {
        "id": "copilot-start-allow",
        "executable": "copilot",
        "args": [
          "-C",
          "{folder:folder}",
          "--session-id",
          "{session:id}",
          "-n",
          "{title:text}",
          {
            "if": "model",
            "args": ["--model", "{model:text}"]
          },
          "--allow-all-tools"
        ],
        "stdin": "text",
        "mode": "detached"
      },
      {
        "id": "copilot-resume",
        "executable": "copilot",
        "args": ["-C", "{folder:folder}", "--resume", "{session:id}"],
        "mode": "terminal"
      },
      {
        "id": "copilot-version",
        "executable": "copilot",
        "args": ["--version"],
        "mode": "capture",
        "timeoutSeconds": 10
      },
      {
        "id": "opencode-attach",
        "executable": "opencode",
        "args": [
          "attach",
          "{server:connection-url}",
          "-s",
          "{session:id}",
          "--dir",
          "{folder:folder}"
        ],
        "mode": "terminal"
      },
      {
        "id": "opencode-version",
        "executable": "opencode",
        "args": ["--version"],
        "mode": "capture",
        "timeoutSeconds": 10
      },
      {
        "id": "codex-app-server",
        "executable": "codex",
        "args": ["-C", "{folder:folder}", "app-server"],
        "mode": "session",
        "idleTimeoutSeconds": 1800
      },
      {
        "id": "codex-resume",
        "executable": "codex",
        "args": ["resume", "-C", "{folder:folder}", "{thread:id}"],
        "mode": "terminal"
      },
      {
        "id": "codex-version",
        "executable": "codex",
        "args": ["--version"],
        "mode": "capture",
        "timeoutSeconds": 10
      }
    ],
    "openSchemes": ["codex"]
  }
}
