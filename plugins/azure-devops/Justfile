# Azure DevOps connector command surface

set quiet
set windows-shell := ["powershell.exe", "-NoLogo", "-Command"]

PNPM := "corepack pnpm"

[private]
default: help

[doc("Displays available commands")]
help:
    just --list --unsorted

[doc("Installs dependencies from the lockfile")]
install:
    corepack enable
    {{PNPM}} install

[doc("Runs the connector tests")]
test:
    {{PNPM}} test

[doc("Type-checks the TypeScript source Ajour runs")]
typecheck:
    {{PNPM}} typecheck

[doc("Runs the complete local CI verification")]
verify:
    {{PNPM}} verify
