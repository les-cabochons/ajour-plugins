  "entrypoint": "src/plugin.ts",
  "capabilities": {
    "projectSource": {}
  },
  "connectionFields": [
    { "id": "label", "label": "Connection label", "type": "text", "required": true, "placeholder": "Name this connection" },
    { "id": "tenantLabel", "label": "Organization", "type": "text", "required": true, "placeholder": "Your company name" },
    {
      "id": "forwarderUrl",
      "label": "Forwarder URL",
      "type": "url",
      "required": true,
      "defaultValue": "https://chronops-forwarder.minehunter.az.nventive.com",
      "helpText": "MineHunter's ChronOps Forwarder. Keep the default unless you run your own MineHunter."
    },
    {
      "id": "personalToken",
      "label": "Personal token",
      "type": "password",
      "required": true,
      "secret": true,
      "placeholder": "Paste a read token from your ChronOps profile",
      "helpText": "Create it on your ChronOps profile with the read scope. Ajour only reads your projects, so a read-write token gives it more than it needs."
    }
  ],
  "network": {
    "auth": {
      "scheme": "headerTemplate",
      "header": "X-ChronOps-Token",
      "template": "{secret}",
      "secretField": "personalToken"
    },
    "baseAddress": { "field": "forwarderUrl", "allowOnPremises": true },
    "endpoints": [
      { "method": "GET", "path": "/integration/me" },
      { "method": "GET", "path": "/integration/snapshot" }
    ],
    "requestHeaders": ["X-ChronOps-Source", "If-None-Match"]
  },
  "runtime": { "start": "whenNeeded" }
}
