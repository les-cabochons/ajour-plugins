{
  "id": "agent-handoff",
  "version": "0.13.0",
  "apiVersion": 4,
  "displayName": "Agent handoff",
  "description": "Hand off backlog items to T3 Code, Claude Code, Copilot CLI, OpenCode, Codex or VS Code, and follow their work where the tool reports it.",
  "entrypoint": "src/plugin.ts",
  "iconSvg": "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\"><path d=\"M3 5h18v12H11l-5 4v-4H3z\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"/></svg>",
  "capabilities": {
    "handoff": {
      "promptTemplate": "[{{item.key}}] {{item.title}}\n\nWork on this {{item.type}} in the {{repo.name}} repository, from the folder you start in. Work on the branch you are on, and open a pull request when you are done.\n\nLink: {{item.url}}\nParent, if any: {{item.parent.key}} {{item.parent.title}}\n\n{{item.description}}",
      "tools": [
        {
          "id": "t3",
          "label": "T3 Code",
          "followsState": true,
          "listsThreads": true,
          "hooks": false,
          "iconSvg": "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\"><rect width=\"24\" height=\"24\" rx=\"5.5\" fill=\"#000\"/><path transform=\"scale(.1875)\" fill=\"#fff\" d=\"M33.4509 93V47.56H15.5309V37H64.3309V47.56H46.4109V93H33.4509ZM86.7253 93.96C82.832 93.96 78.9653 93.4533 75.1253 92.44C71.2853 91.3733 68.032 89.88 65.3653 87.96L70.4053 78.04C72.5386 79.5867 75.0186 80.8133 77.8453 81.72C80.672 82.6267 83.5253 83.08 86.4053 83.08C89.6586 83.08 92.2186 82.44 94.0853 81.16C95.952 79.88 96.8853 78.12 96.8853 75.88C96.8853 73.7467 96.0586 72.0667 94.4053 70.84C92.752 69.6133 90.0853 69 86.4053 69H80.4853V60.44L96.0853 42.76L97.5253 47.4H68.1653V37H107.365V45.4L91.8453 63.08L85.2853 59.32H89.0453C95.9253 59.32 101.125 60.8667 104.645 63.96C108.165 67.0533 109.925 71.0267 109.925 75.88C109.925 79.0267 109.099 81.9867 107.445 84.76C105.792 87.48 103.259 89.6933 99.8453 91.4C96.432 93.1067 92.0586 93.96 86.7253 93.96Z\"/><rect x=\".5\" y=\".5\" width=\"23\" height=\"23\" rx=\"5\" fill=\"none\" stroke=\"#fff\" stroke-opacity=\".18\"/></svg>",
          "settings": [
            {
              "id": "worktree",
              "label": "Create a worktree",
              "type": "checkbox",
              "defaultValue": true,
              "helpText": "Run the thread in a new git worktree on the handoff branch, instead of the project folder."
            },
            {
              "id": "base",
              "label": "Worktree base",
              "type": "text",
              "defaultValue": "main",
              "helpText": "The branch, tag or commit the worktree starts from."
            },
            {
              "id": "provider",
              "label": "Provider",
              "type": "text",
              "placeholder": "claudeAgent",
              "helpText": "A T3 Code provider instance ID. A provider needs a model. Leave both empty for the project defaults."
            },
            {
              "id": "model",
              "label": "Model",
              "type": "text",
              "placeholder": "claude-opus-5-5",
              "helpText": "A model slug, which can contain slashes. Leave empty for the project's default model."
            }
          ]
        },
        {
          "id": "claude",
          "label": "Claude Code",
          "followsState": true,
          "listsThreads": true,
          "hooks": true,
          "iconSvg": "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\"><rect width=\"24\" height=\"24\" rx=\"5.5\" fill=\"#D97757\"/><path transform=\"translate(4.2 4.2) scale(.65)\" fill=\"#FAF9F5\" d=\"m4.714 15.956l4.718-2.648l.079-.23l-.08-.128h-.23l-.79-.048l-2.695-.073l-2.337-.097l-2.265-.122l-.57-.121l-.535-.704l.055-.353l.48-.321l.685.06l1.518.104l2.277.157l1.651.098l2.447.255h.389l.054-.158l-.133-.097l-.103-.098l-2.356-1.596l-2.55-1.688l-1.336-.972l-.722-.491L2 6.223l-.158-1.008l.656-.722l.88.06l.224.061l.893.686l1.906 1.476l2.49 1.833l.364.304l.146-.104l.018-.072l-.164-.274l-1.354-2.446l-1.445-2.49l-.644-1.032l-.17-.619a3 3 0 0 1-.103-.729L6.287.133L6.7 0l.995.134l.42.364l.619 1.415L9.735 4.14l1.555 3.03l.455.898l.243.832l.09.255h.159V9.01l.127-1.706l.237-2.095l.23-2.695l.08-.76l.376-.91l.747-.492l.583.28l.48.685l-.067.444l-.286 1.851l-.558 2.903l-.365 1.942h.213l.243-.242l.983-1.306l1.652-2.064l.728-.82l.85-.904l.547-.431h1.032l.759 1.129l-.34 1.166l-1.063 1.347l-.88 1.142l-1.263 1.7l-.79 1.36l.074.11l.188-.02l2.853-.606l1.542-.28l1.84-.315l.832.388l.09.395l-.327.807l-1.967.486l-2.307.462l-3.436.813l-.043.03l.049.061l1.548.146l.662.036h1.62l3.018.225l.79.522l.473.638l-.08.485l-1.213.62l-1.64-.389l-3.825-.91l-1.31-.329h-.183v.11l1.093 1.068l2.003 1.81l2.508 2.33l.127.578l-.321.455l-.34-.049l-2.204-1.657l-.85-.747l-1.925-1.62h-.127v.17l.443.649l2.343 3.521l.122 1.08l-.17.353l-.607.213l-.668-.122l-1.372-1.924l-1.415-2.168l-1.141-1.943l-.14.08l-.674 7.254l-.316.37l-.728.28l-.607-.461l-.322-.747l.322-1.476l.388-1.924l.316-1.53l.285-1.9l.17-.632l-.012-.042l-.14.018l-1.432 1.967l-2.18 2.945l-1.724 1.845l-.413.164l-.716-.37l.066-.662l.401-.589l2.386-3.036l1.439-1.882l.929-1.086l-.006-.158h-.055L4.138 18.56l-1.13.146l-.485-.456l.06-.746l.231-.243l1.907-1.312Z\"/></svg>",
          "settings": [
            {
              "id": "startMode",
              "label": "Start",
              "type": "select",
              "defaultValue": "background",
              "options": [
                {
                  "value": "background",
                  "label": "In the background"
                },
                {
                  "value": "terminal",
                  "label": "In the background, and open it in a terminal"
                }
              ],
              "helpText": "Claude Code always gets the prompt as a background session. Open shows it in your terminal later, or right away with the second choice."
            },
            {
              "id": "model",
              "label": "Model",
              "type": "text",
              "placeholder": "opus",
              "helpText": "A model alias such as opus or sonnet, or a full model name. Leave empty for your Claude Code default."
            }
          ]
        },
        {
          "id": "copilot",
          "label": "Copilot CLI",
          "followsState": false,
          "listsThreads": false,
          "hooks": false,
          "iconSvg": "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\"><rect width=\"24\" height=\"24\" rx=\"5.5\" fill=\"#0D1117\"/><path transform=\"translate(4.2 4.2) scale(.65)\" fill=\"#fff\" d=\"M23.922 16.997C23.061 18.492 18.063 22.02 12 22.02S.939 18.492.078 16.997A.6.6 0 0 1 0 16.741v-2.869a1 1 0 0 1 .053-.22c.372-.935 1.347-2.292 2.605-2.656c.167-.429.414-1.055.644-1.517a10 10 0 0 1-.052-1.086c0-1.331.282-2.499 1.132-3.368c.397-.406.89-.717 1.474-.952C7.255 2.937 9.248 1.98 11.978 1.98s4.767.957 6.166 2.093c.584.235 1.077.546 1.474.952c.85.869 1.132 2.037 1.132 3.368c0 .368-.014.733-.052 1.086c.23.462.477 1.088.644 1.517c1.258.364 2.233 1.721 2.605 2.656a.8.8 0 0 1 .053.22v2.869a.6.6 0 0 1-.078.256m-11.75-5.992h-.344a4 4 0 0 1-.355.508c-.77.947-1.918 1.492-3.508 1.492c-1.725 0-2.989-.359-3.782-1.259a2 2 0 0 1-.085-.104L4 11.746v6.585c1.435.779 4.514 2.179 8 2.179s6.565-1.4 8-2.179v-6.585l-.098-.104s-.033.045-.085.104c-.793.9-2.057 1.259-3.782 1.259c-1.59 0-2.738-.545-3.508-1.492a4 4 0 0 1-.355-.508m2.328 3.25c.549 0 1 .451 1 1v2c0 .549-.451 1-1 1s-1-.451-1-1v-2c0-.549.451-1 1-1m-5 0c.549 0 1 .451 1 1v2c0 .549-.451 1-1 1s-1-.451-1-1v-2c0-.549.451-1 1-1m3.313-6.185c.136 1.057.403 1.913.878 2.497c.442.544 1.134.938 2.344.938c1.573 0 2.292-.337 2.657-.751c.384-.435.558-1.15.558-2.361c0-1.14-.243-1.847-.705-2.319c-.477-.488-1.319-.862-2.824-1.025c-1.487-.161-2.192.138-2.533.529c-.269.307-.437.808-.438 1.578v.021q0 .397.063.893m-1.626 0q.063-.496.063-.894v-.02c-.001-.77-.169-1.271-.438-1.578c-.341-.391-1.046-.69-2.533-.529c-1.505.163-2.347.537-2.824 1.025c-.462.472-.705 1.179-.705 2.319c0 1.211.175 1.926.558 2.361c.365.414 1.084.751 2.657.751c1.21 0 1.902-.394 2.344-.938c.475-.584.742-1.44.878-2.497\"/><rect x=\".5\" y=\".5\" width=\"23\" height=\"23\" rx=\"5\" fill=\"none\" stroke=\"#fff\" stroke-opacity=\".18\"/></svg>",
          "settings": [
            {
              "id": "tools",
              "label": "Tools",
              "type": "select",
              "defaultValue": "ask",
              "options": [
                {
                  "value": "ask",
                  "label": "Only the ones you already allowed"
                },
                {
                  "value": "allow",
                  "label": "Allow all tools (--allow-all-tools)"
                }
              ],
              "helpText": "Copilot CLI works on the prompt without a terminal, so it can't ask before it edits a file or runs a command: it skips each one you haven't allowed. Open the session to allow them and continue, or let it use every tool."
            },
            {
              "id": "model",
              "label": "Model",
              "type": "text",
              "placeholder": "auto",
              "helpText": "A model name, or auto to let Copilot choose. Leave empty for your Copilot CLI default."
            }
          ]
        },
        {
          "id": "opencode",
          "label": "OpenCode",
          "iconSvg": "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\"><rect width=\"24\" height=\"24\" rx=\"5.5\" fill=\"#F1ECEC\"/><g transform=\"translate(6.4 5) scale(.35)\"><path d=\"M24 32H8V16H24V32Z\" fill=\"#BCBBBB\"/><path d=\"M24 8H8V32H24V8ZM32 40H0V0H32V40Z\" fill=\"#211E1E\"/></g><rect x=\".5\" y=\".5\" width=\"23\" height=\"23\" rx=\"5\" fill=\"none\" stroke=\"#000\" stroke-opacity=\".12\"/></svg>",
          "followsState": true,
          "listsThreads": true,
          "hooks": false,
          "settings": [
            {
              "id": "model",
              "label": "Model",
              "type": "text",
              "placeholder": "anthropic/claude-sonnet-4-5",
              "helpText": "A provider and model as provider/model. Leave empty for your OpenCode default."
            },
            {
              "id": "agent",
              "label": "Agent",
              "type": "text",
              "placeholder": "build",
              "helpText": "An OpenCode agent, such as build or plan. Leave empty for your OpenCode default. OpenCode works without a terminal, so it can't ask you first: it skips each action the agent would ask about, such as reading a .env file, and goes on."
            }
          ]
        },
        {
          "id": "codex",
          "label": "Codex",
          "followsState": true,
          "listsThreads": true,
          "hooks": false,
          "iconSvg": "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\"><rect width=\"24\" height=\"24\" rx=\"5.5\" fill=\"#fff\"/><path transform=\"translate(4.32 4.2) scale(.06)\" fill=\"#0D0D0D\" d=\"M239.184 106.203a64.716 64.716 0 0 0-5.576-53.103C219.452 28.459 191 15.784 163.213 21.74A65.586 65.586 0 0 0 52.096 45.22a64.716 64.716 0 0 0-43.23 31.36c-14.31 24.602-11.061 55.634 8.033 76.74a64.665 64.665 0 0 0 5.525 53.102c14.174 24.65 42.644 37.324 70.446 31.36a64.72 64.72 0 0 0 48.754 21.744c28.481.025 53.714-18.361 62.414-45.481a64.767 64.767 0 0 0 43.229-31.36c14.137-24.558 10.875-55.423-8.083-76.483Zm-97.56 136.338a48.397 48.397 0 0 1-31.105-11.255l1.535-.87 51.67-29.825a8.595 8.595 0 0 0 4.247-7.367v-72.85l21.845 12.636c.218.111.37.32.409.563v60.367c-.056 26.818-21.783 48.545-48.601 48.601Zm-104.466-44.61a48.345 48.345 0 0 1-5.781-32.589l1.534.921 51.722 29.826a8.339 8.339 0 0 0 8.441 0l63.181-36.425v25.221a.87.87 0 0 1-.358.665l-52.335 30.184c-23.257 13.398-52.97 5.431-66.404-17.803ZM23.549 85.38a48.499 48.499 0 0 1 25.58-21.333v61.39a8.288 8.288 0 0 0 4.195 7.316l62.874 36.272-21.845 12.636a.819.819 0 0 1-.767 0L41.353 151.53c-23.211-13.454-31.171-43.144-17.804-66.405v.256Zm179.466 41.695-63.08-36.63L161.73 77.86a.819.819 0 0 1 .768 0l52.233 30.184a48.6 48.6 0 0 1-7.316 87.635v-61.391a8.544 8.544 0 0 0-4.4-7.213Zm21.742-32.69-1.535-.922-51.619-30.081a8.39 8.39 0 0 0-8.492 0L99.98 99.808V74.587a.716.716 0 0 1 .307-.665l52.233-30.133a48.652 48.652 0 0 1 72.236 50.391v.205ZM88.061 139.097l-21.845-12.585a.87.87 0 0 1-.41-.614V65.685a48.652 48.652 0 0 1 79.757-37.346l-1.535.87-51.67 29.825a8.595 8.595 0 0 0-4.246 7.367l-.051 72.697Zm11.868-25.58 28.138-16.217 28.188 16.218v32.434l-28.086 16.218-28.188-16.218-.052-32.434Z\"/><rect x=\".5\" y=\".5\" width=\"23\" height=\"23\" rx=\"5\" fill=\"none\" stroke=\"#000\" stroke-opacity=\".14\"/></svg>",
          "settings": [
            {
              "id": "open",
              "label": "Open",
              "type": "select",
              "defaultValue": "app",
              "options": [
                {
                  "value": "app",
                  "label": "In the Codex app"
                },
                {
                  "value": "terminal",
                  "label": "In a terminal (codex resume)"
                }
              ],
              "helpText": "Where Open shows the thread. The Codex app opens it from its codex:// link; the terminal runs codex resume in the repository folder. Ajour runs at most two Codex handoffs at once."
            },
            {
              "id": "model",
              "label": "Model",
              "type": "text",
              "placeholder": "gpt-5.5",
              "helpText": "A model name for the thread. Leave empty for your Codex default."
            }
          ]
        },
        {
          "id": "vscode",
          "label": "VS Code",
          "followsState": false,
          "listsThreads": false,
          "hooks": false,
          "iconSvg": "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\"><rect width=\"24\" height=\"24\" rx=\"5.5\" fill=\"#007ACC\"/><path transform=\"translate(4.5 4.5) scale(.0586)\" fill=\"#fff\" fill-rule=\"evenodd\" d=\"M181.534 254.252a15.934 15.934 0 0 0 12.7-.488l52.706-25.361a16.002 16.002 0 0 0 9.06-14.42V42.018c0-6.15-3.522-11.754-9.06-14.42L194.234 2.238a15.939 15.939 0 0 0-18.185 3.097l-100.9 92.052-43.95-33.361a10.655 10.655 0 0 0-13.614.605L3.49 77.453c-4.648 4.227-4.653 11.54-.011 15.774L41.593 128 3.478 162.773c-4.642 4.235-4.637 11.547.011 15.775l14.097 12.822a10.655 10.655 0 0 0 13.613.606l43.95-33.362 100.9 92.053a15.915 15.915 0 0 0 5.485 3.585Zm10.505-184.367L115.479 128l76.56 58.115V69.885Z\"/></svg>",
          "settings": []
        }
      ]
    }
  },
  "processes": {
    "executables": {
      "t3": {
        "names": ["t3"]
      },
      "claude": {
        "names": ["claude"]
      },
      "copilot": {
        "names": ["copilot"]
      },
      "opencode": {
        "names": ["opencode"]
      },
      "codex": {
        "names": ["codex"]
      },
      "vscode": {
        "names": ["code"]
      }
    },
    "commands": [
      {
        "id": "thread-start",
        "executable": "t3",
        "args": [
          "thread",
          "start",
          "{folder:folder}",
          "-",
          "--title",
          "{title:text}",
          "--json",
          {
            "if": "branch",
            "args": ["--worktree", "{base:ref}", "--branch", "{branch:ref}"]
          },
          {
            "if": "provider",
            "args": ["--provider", "{provider:text}"]
          },
          {
            "if": "model",
            "args": ["--model", "{model:text}"]
          }
        ],
        "stdin": "text",
        "mode": "capture",
        "timeoutSeconds": 20
      },
      {
        "id": "thread-list",
        "executable": "t3",
        "args": ["thread", "list", "--project", "{folder:folder}", "--json"],
        "mode": "capture",
        "timeoutSeconds": 10
      },
      {
        "id": "thread-show",
        "executable": "t3",
        "args": ["thread", "show", "{thread:id}", "--json", "--messages", "0"],
        "cwd": "{folder:folder}",
        "mode": "capture",
        "timeoutSeconds": 10
      },
      {
        "id": "version",
        "executable": "t3",
        "args": ["--version"],
        "mode": "capture",
        "timeoutSeconds": 10
      },
      {
        "id": "claude-start",
        "executable": "claude",
        "args": [
          "--bg",
          "--name",
          "{title:text}",
          {
            "if": "model",
            "args": ["--model", "{model:text}"]
          },
          "--add-dir",
          "{folder:folder}"
        ],
        "stdin": "text",
        "mode": "capture",
        "timeoutSeconds": 20
      },
      {
        "id": "claude-start-hook",
        "executable": "claude",
        "args": [
          "--bg",
          "--name",
          "{title:text}",
          {
            "if": "model",
            "args": ["--model", "{model:text}"]
          },
          "--settings",
          {
            "kind": "hook-url",
            "name": "hook",
            "template": "{\"hooks\":{\"Notification\":[{\"hooks\":[{\"type\":\"http\",\"url\":\"{url}\",\"timeout\":5}]}],\"SessionEnd\":[{\"hooks\":[{\"type\":\"http\",\"url\":\"{url}\"}]}]}}"
          },
          "--add-dir",
          "{folder:folder}"
        ],
        "stdin": "text",
        "mode": "capture",
        "timeoutSeconds": 20
      },
      {
        "id": "claude-agents",
        "executable": "claude",
        "args": ["agents", "--json", "--all"],
        "mode": "capture",
        "timeoutSeconds": 10
      },
      {
        "id": "claude-agents-folder",
        "executable": "claude",
        "args": ["agents", "--json", "--all", "--cwd", "{folder:folder}"],
        "mode": "capture",
        "timeoutSeconds": 10
      },
      {
        "id": "claude-attach",
        "executable": "claude",
        "args": ["attach", "{job:id}", "{folder:folder}"],
        "mode": "terminal"
      },
      {
        "id": "claude-version",
        "executable": "claude",
        "args": ["--version"],
        "mode": "capture",
        "timeoutSeconds": 10
      },
      {
        "id": "claude-trust",
        "executable": "claude",
        "args": [],
        "cwd": "{folder:folder}",
        "mode": "terminal"
      },
      {
        "id": "copilot-start",
        "executable": "copilot",
        "args": [
          "-C",
          "{folder:folder}",
          "--session-id",
          "{session:id}",
          "-n",
          "{title:text}",
          {
            "if": "model",
            "args": ["--model", "{model:text}"]
          }
        ],
        "stdin": "text",
        "mode": "detached"
      },
      {
        "id": "copilot-start-allow",
        "executable": "copilot",
        "args": [
          "-C",
          "{folder:folder}",
          "--session-id",
          "{session:id}",
          "-n",
          "{title:text}",
          {
            "if": "model",
            "args": ["--model", "{model:text}"]
          },
          "--allow-all-tools"
        ],
        "stdin": "text",
        "mode": "detached"
      },
      {
        "id": "copilot-resume",
        "executable": "copilot",
        "args": ["-C", "{folder:folder}", "--resume", "{session:id}"],
        "mode": "terminal"
      },
      {
        "id": "copilot-version",
        "executable": "copilot",
        "args": ["--version"],
        "mode": "capture",
        "timeoutSeconds": 10
      },
      {
        "id": "opencode-run",
        "executable": "opencode",
        "args": [
          "run",
          "-s",
          "{session:id}",
          "--title",
          "{title:text}",
          {
            "if": "model",
            "args": ["--model", "{model:text}"]
          },
          {
            "if": "agent",
            "args": ["--agent", "{agent:text}"]
          }
        ],
        "cwd": "{folder:folder}",
        "stdin": "text",
        "mode": "detached"
      },
      {
        "id": "opencode-session",
        "executable": "opencode",
        "args": ["api", "session.get", "--param", "{session:text}"],
        "mode": "capture",
        "timeoutSeconds": 10
      },
      {
        "id": "opencode-messages",
        "executable": "opencode",
        "args": [
          "api",
          "session.message.list",
          "--param",
          "{session:text}",
          "--param",
          "limit=1"
        ],
        "mode": "capture",
        "timeoutSeconds": 10
      },
      {
        "id": "opencode-sessions",
        "executable": "opencode",
        "args": ["session", "list", "--format", "json", "-n", "{limit:number}"],
        "cwd": "{folder:folder}",
        "mode": "capture",
        "timeoutSeconds": 10
      },
      {
        "id": "opencode-open",
        "executable": "opencode",
        "args": ["{folder:folder}", "-s", "{session:id}"],
        "mode": "terminal"
      },
      {
        "id": "opencode-version",
        "executable": "opencode",
        "args": ["--version"],
        "mode": "capture",
        "timeoutSeconds": 10
      },
      {
        "id": "codex-app-server",
        "executable": "codex",
        "args": ["-C", "{folder:folder}", "app-server"],
        "mode": "session",
        "idleTimeoutSeconds": 1800
      },
      {
        "id": "codex-resume",
        "executable": "codex",
        "args": ["resume", "-C", "{folder:folder}", "{thread:id}"],
        "mode": "terminal"
      },
      {
        "id": "codex-version",
        "executable": "codex",
        "args": ["--version"],
        "mode": "capture",
        "timeoutSeconds": 10
      },
      {
        "id": "vscode-chat",
        "executable": "vscode",
        "args": ["chat", "-m", "agent", "{request:text}", "-"],
        "cwd": "{folder:folder}",
        "stdin": "text",
        "mode": "detached"
      },
      {
        "id": "vscode-version",
        "executable": "vscode",
        "args": ["--version"],
        "mode": "capture",
        "timeoutSeconds": 10
      }
    ],
    "openSchemes": ["codex", "t3code"]
  }
}
