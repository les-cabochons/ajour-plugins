{
  "name": "@les-cabochons/ajc-azure-devops",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@10.7.0",
  "ajour": {
    "description": "Sync Azure DevOps work items into Ajour's local backlog and update estimates from Ajour, and bring in your pull requests.",
    "features": [
      "work-item-sync",
      "estimate-update",
      "pull-requests"
    ],
    "tags": [
      "azure-devops",
      "project-management",
      "synchronization"
    ],
    "author": {
      "name": "Alex Trépanier",
      "url": "https://github.com/alextrepa"
    },
    "license": {
      "name": "MIT License",
      "spdxId": "MIT"
    },
    "website": "https://github.com/les-cabochons/ajour-plugins/tree/main/plugins/azure-devops#readme",
    "status": "available",
    "files": [
      "plugin.json",
      "package.json",
      "LICENSE",
      "src"
    ]
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json",
    "verify": "corepack pnpm test && corepack pnpm typecheck"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "typescript": "^5.8.2",
    "vitest": "^4.1.5"
  }
}
